{
  "name": "cihof-rebuild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-data.js",
    "curate:metadata": "node scripts/generate-curated-metadata.js",
    "curate:report": "node scripts/curation-report.js",
    "curate:apply": "node scripts/apply-curation-decisions.js",
    "content:first-pass": "node scripts/generate-first-pass-content-decisions.js",
    "media:manifest": "node scripts/generate-media-manifest.js",
    "media:localize": "node scripts/localize-media.js",
    "media:validate": "node scripts/validate-media.js",
    "media:apply": "node scripts/apply-media-decisions.js",
    "media:youtube-plan": "node scripts/plan-youtube-media-acquisition.js",
    "traces:generate": "node scripts/generate-cleveland-traces.mjs",
    "source:harvest": "node scripts/harvest-original-site.js",
    "source:candidates": "node scripts/generate-source-candidates.js",
    "source:drafts": "node scripts/generate-source-drafts.js",
    "validate:entities": "node scripts/validate-entity-model.js",
    "validate:kiosk": "npm run curate:report && npm run media:validate -- --strict --profile=wall",
    "validate:media-clearance": "npm run media:validate -- --strict --profile=full",
    "validate:offline": "node scripts/validate-offline-package.js",
    "build:kiosk": "npm run validate:kiosk && npm run prepare:data && tsc -b && CIHOF_BUILD_TARGET=kiosk vite build",
    "build:public": "npm run prepare:data && tsc -b && CIHOF_BUILD_TARGET=kiosk vite build",
    "build:portal": "npm run prepare:data && tsc -b && CIHOF_BUILD_TARGET=portal vite build",
    "import:2026": "node scripts/import-2026-live-data.js",
    "portal:server": "node scripts/portal-runner.js",
    "test:kiosk": "playwright test",
    "dev": "npm run prepare:data && vite",
    "dev:portal": "npm run prepare:data && vite --open /portal.html",
    "build": "npm run prepare:data && tsc -b && vite build",
    "preview": "vite preview",
    "audit:data": "node scripts/audit-data.js",
    "test:portal": "playwright test -c playwright.portal.config.ts"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
