{
  "name": "cihof-rebuild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-data.js",
    "curate:metadata": "node scripts/generate-curated-metadata.js",
    "curate:report": "node scripts/curation-report.js",
    "curate:apply": "node scripts/apply-curation-decisions.js",
    "content:first-pass": "node scripts/generate-first-pass-content-decisions.js",
    "content:review": "node scripts/review-non-external-content.js",
    "content:repair-summaries": "node scripts/repair-story-summaries.js",
    "content:repair-life-work": "node scripts/repair-life-work-summaries.js",
    "content:repair-week1-remaining": "node scripts/repair-week1-remaining-text-flags.js",
    "content:polish-summaries": "node scripts/sync-story-summary-drafts.js",
    "content:text-readiness": "node scripts/review-text-readiness.js",
    "media:manifest": "node scripts/generate-media-manifest.js",
    "media:localize": "node scripts/localize-media.js",
    "media:gallery-localize": "node scripts/localize-remote-gallery-images.js",
    "media:video-sync": "node scripts/sync-missing-video-files.js",
    "media:validate": "node scripts/validate-media.js",
    "media:apply": "node scripts/apply-media-decisions.js",
    "media:approval-sheet": "node scripts/export-media-approval-sheet.js",
    "media:youtube-plan": "node scripts/plan-youtube-media-acquisition.js",
    "media:video-normalize": "node scripts/normalize-video-manifest-paths.js",
    "media:video-dedupe": "node scripts/dedupe-video-hardlinks.js",
    "media:video-captions": "node scripts/fill-video-captions-transcripts.js",
    "media:video-transcribe": "node scripts/transcribe-missing-video-captions.js",
    "traces:generate": "node scripts/generate-cleveland-traces.mjs",
    "source:harvest": "node scripts/harvest-original-site.js",
    "source:candidates": "node scripts/generate-source-candidates.js",
    "source:drafts": "node scripts/generate-source-drafts.js",
    "source:external-research": "node scripts/collect-external-research.js",
    "source:external-contributions": "node scripts/filter-external-contributions.js",
    "validate:entities": "node scripts/validate-entity-model.js",
    "validate:kiosk": "npm run curate:report && npm run media:validate -- --strict --profile=wall",
    "validate:media-clearance": "npm run media:validate -- --strict --profile=full",
    "validate:offline": "node scripts/validate-offline-package.js",
    "typecheck": "tsc -b --pretty false",
    "check:handoff": "npm run build && npm run build:portal && npm run validate:entities && npm run validate:offline",
    "build:kiosk": "npm run validate:kiosk && npm run prepare:data && tsc -b && CIHOF_BUILD_TARGET=kiosk vite build",
    "build:public": "npm run prepare:data && tsc -b && CIHOF_BUILD_TARGET=public vite build",
    "build:portal": "npm run prepare:data && tsc -b && CIHOF_BUILD_TARGET=portal vite build",
    "import:2026": "node scripts/import-2026-live-data.js",
    "launch:readiness": "node scripts/launch-readiness-report.js",
    "launch:readiness:strict": "node scripts/launch-readiness-report.js --strict",
    "portal:server": "node scripts/portal-runner.js",
    "test:kiosk": "playwright test",
    "dev": "npm run prepare:data && vite",
    "dev:portal": "npm run prepare:data && vite --open /portal.html",
    "build": "npm run prepare:data && tsc -b && vite build",
    "preview": "vite preview",
    "audit:data": "node scripts/audit-data.js",
    "test:portal": "playwright test -c playwright.portal.config.ts"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-force": "^3.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
