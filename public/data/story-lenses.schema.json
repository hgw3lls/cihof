{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hgw3lls.github.io/cihof/data/story-lenses.schema.json",
  "title": "CIHOF Story Lenses",
  "type": "object",
  "required": [
    "schemaVersion",
    "lenses"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number"
    },
    "updatedAt": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "lenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "prompt",
          "description",
          "terms",
          "themes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "themes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "maxPortraits": {
            "type": "number",
            "minimum": 12,
            "maximum": 96
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
