{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIHOF Cleveland places",
  "type": "object",
  "required": ["schemaVersion", "source", "placeTypes", "places"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["name", "generatedAt"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "generatedAt": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "placeTypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/placeType" },
      "uniqueItems": true
    },
    "places": {
      "type": "array",
      "items": { "$ref": "#/$defs/place" }
    }
  },
  "$defs": {
    "placeType": {
      "type": "string",
      "enum": [
        "neighborhood",
        "cultural_center",
        "church",
        "school",
        "civic_building",
        "cultural_garden",
        "business",
        "festival_location",
        "community_organization",
        "historic_address"
      ]
    },
    "place": {
      "type": "object",
      "required": ["id", "name", "type", "shortHistory", "marker", "related", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/placeType" },
        "shortHistory": { "type": "string" },
        "marker": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 100 },
            "y": { "type": "number", "minimum": 0, "maximum": 100 },
            "labelOffsetX": { "type": "number" },
            "labelOffsetY": { "type": "number" }
          }
        },
        "neighborhood": { "type": "string" },
        "address": { "type": "string" },
        "dateRange": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" },
            "label": { "type": "string" }
          }
        },
        "related": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "people": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "communities": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "organizations": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "url", "altText"],
            "additionalProperties": false,
            "properties": {
              "kind": { "const": "image" },
              "url": { "type": "string" },
              "altText": { "type": "string" },
              "caption": { "type": "string" }
            }
          }
        },
        "provenance": {
          "type": "object",
          "required": ["source", "confidence"],
          "additionalProperties": true,
          "properties": {
            "source": { "type": "string" },
            "confidence": {
              "type": "string",
              "enum": ["documented", "curated", "inferred"]
            },
            "sourceRecordId": { "type": "string" },
            "sourceField": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      }
    }
  }
}
