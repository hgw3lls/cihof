{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIHOF relationship metadata",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["sourcePersonId", "targetEntityId", "type", "displayLabel", "provenance"],
    "properties": {
      "sourcePersonId": {
        "type": "string",
        "description": "The source inductee id."
      },
      "targetEntityId": {
        "type": "string",
        "description": "The target entity id. For this portrait-based version, only target ids that match inductee ids are displayed."
      },
      "targetEntityType": {
        "type": "string",
        "enum": ["person", "organization", "place", "community", "event", "theme", "media"],
        "description": "Optional target type for non-person relationship nodes."
      },
      "targetDisplayName": {
        "type": "string",
        "description": "Optional visitor-facing name for a non-person target entity."
      },
      "type": {
        "type": "string",
        "enum": [
          "inducted_by",
          "same_class",
          "shared_theme",
          "shared_organization",
          "shared_community",
          "civic_collaboration",
          "mentor",
          "colleague",
          "family",
          "related_place",
          "related_event"
        ]
      },
      "displayLabel": {
        "type": "string",
        "description": "Short visitor-facing reason shown in the person view."
      },
      "referenceNote": {
        "type": "string",
        "description": "Optional source, citation, or curator note."
      },
      "provenance": {
        "type": "string",
        "enum": ["documented", "curated", "inferred"]
      }
    }
  }
}
