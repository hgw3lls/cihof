{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIHOF entity relationships",
  "type": "object",
  "required": ["schemaVersion", "source", "relationshipTypes", "relationships"],
  "properties": {
    "schemaVersion": { "type": "number" },
    "source": { "type": "object" },
    "relationshipTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "has_theme",
          "member_of_community",
          "associated_with_place",
          "associated_with_organization",
          "participated_in_event",
          "inducted_by_candidate",
          "inducted_in_class",
          "has_media",
          "legacy_related_candidate",
          "related_to"
        ]
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "sourceEntityId", "targetEntityId", "type", "displayLabel", "provenance"],
        "properties": {
          "id": { "type": "string" },
          "sourceEntityId": { "type": "string" },
          "targetEntityId": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "has_theme",
              "member_of_community",
              "associated_with_place",
              "associated_with_organization",
              "participated_in_event",
              "inducted_by_candidate",
              "inducted_in_class",
              "has_media",
              "legacy_related_candidate",
              "related_to"
            ]
          },
          "displayLabel": { "type": "string" },
          "shortDescription": { "type": "string" },
          "provenance": {
            "type": "object",
            "required": ["source", "confidence"],
            "properties": {
              "source": { "type": "string" },
              "sourcePath": { "type": "string" },
              "confidence": { "type": "string", "enum": ["documented", "curated", "inferred"] },
              "sourceRecordId": { "type": "string" },
              "sourceField": { "type": "string" },
              "note": { "type": "string" }
            }
          },
          "attributes": { "type": "object" }
        }
      }
    }
  }
}
