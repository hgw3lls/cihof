{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIHOF story sections",
  "type": "object",
  "required": ["schemaVersion", "source", "records"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "number" },
    "source": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "updatedAt": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/storyRecord" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "string",
      "enum": ["documented", "curated", "inferred"]
    },
    "beatType": {
      "type": "string",
      "enum": [
        "early_life",
        "arrival",
        "building_community",
        "work",
        "struggle",
        "leadership",
        "legacy",
        "memory",
        "recognition"
      ]
    },
    "storyRecord": {
      "type": "object",
      "required": ["inducteeId", "provenance", "beats"],
      "additionalProperties": false,
      "properties": {
        "inducteeId": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "updatedAt": { "type": "string" },
        "curatorNotes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/storyBeat" }
        }
      }
    },
    "storyBeat": {
      "type": "object",
      "required": ["id", "headline", "body"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/$defs/beatType" },
        "headline": { "type": "string" },
        "body": { "type": "string" },
        "imageUrl": { "type": "string" },
        "imageAltText": { "type": "string" },
        "quote": { "type": "string" },
        "place": { "type": "string" },
        "organization": { "type": "string" },
        "relatedPersonId": { "type": "string" },
        "timelineMarker": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
