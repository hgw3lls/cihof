{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIHOF entity model",
  "type": "object",
  "required": ["schemaVersion", "source", "entityTypes", "entities"],
  "properties": {
    "schemaVersion": { "type": "number" },
    "source": { "type": "object" },
    "entityTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Person", "Community", "Place", "Organization", "Event", "Theme", "Media"]
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "displayName", "type", "shortDescription", "provenance"],
        "properties": {
          "id": { "type": "string" },
          "displayName": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["Person", "Community", "Place", "Organization", "Event", "Theme", "Media"]
          },
          "shortDescription": { "type": "string" },
          "media": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "entityId": { "type": "string" },
                "kind": { "type": "string", "enum": ["image", "video", "audio", "document"] },
                "role": { "type": "string" },
                "url": { "type": "string" },
                "altText": { "type": "string" }
              }
            }
          },
          "dateRange": {
            "type": "object",
            "properties": {
              "start": { "type": "string" },
              "end": { "type": "string" },
              "label": { "type": "string" }
            }
          },
          "location": {
            "type": "object",
            "required": ["displayName"],
            "properties": {
              "displayName": { "type": "string" },
              "region": { "type": "string" }
            }
          },
          "provenance": {
            "type": "object",
            "required": ["source", "confidence"],
            "properties": {
              "source": { "type": "string" },
              "sourcePath": { "type": "string" },
              "confidence": { "type": "string", "enum": ["documented", "curated", "inferred"] },
              "sourceRecordId": { "type": "string" },
              "sourceField": { "type": "string" },
              "note": { "type": "string" }
            }
          },
          "attributes": { "type": "object" }
        }
      }
    }
  }
}
