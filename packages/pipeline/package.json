{
  "name": "@cihof/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reads canonical sources and emits published artifacts. No framework.",
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "crosswalk": "node --experimental-strip-types scripts/crosswalk.mjs",
    "review:links": "node --experimental-strip-types scripts/review-sheet.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*"
  }
}
