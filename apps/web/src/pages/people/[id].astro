---
import Layout from '../../layouts/Page.astro';
import { buildPeople } from '@cihof/pipeline/src/build/people.ts';
import { displayablePortrait, facetable, isAttributable } from '@cihof/content';

export function getStaticPaths() {
  return buildPeople().map((person) => ({ params: { id: person.id }, props: { person } }));
}

const { person } = Astro.props;
const base = import.meta.env.BASE_URL;
const portrait = displayablePortrait(person.portrait);

/**
 * Only text somebody stands behind is shown as prose.
 *
 * `contribution` and `context` are machine-composed for all 111 people, despite
 * the roster documenting them as curator-written. Rendering them would put a
 * generator's voice on a public page in the institution's name. The approved
 * contribution tags carry the same information with an owner, so they are shown
 * instead.
 */
const biography = isAttributable(person.biography) ? person.biography : null;
const paragraphs = biography ? biography.text.split(/\n{2,}/).map((part) => part.trim()).filter(Boolean) : [];
const contributions = facetable(person.contributions);
const communities = facetable(person.communities);
const countries = facetable(person.countries);
const summary = paragraphs[0]?.slice(0, 180) ?? '';
---
<Layout title={`${person.name} — Cleveland International Hall of Fame`} description={summary}>
  {portrait && (
    <img
      class="portrait"
      src={`${base}${portrait.src.replace(/^\//, '')}`}
      alt={portrait.alt}
      width="320"
      height="324"
      decoding="async"
    />
  )}

  <h1>{person.name}</h1>
  <p class="meta">{person.classYear ? `Inducted ${person.classYear}` : 'Induction year not recorded'}</p>

  {contributions.length > 0 && (
    <>
      <h2>Honored for</h2>
      <ul class="tags">{contributions.map((tag) => <li>{tag}</li>)}</ul>
    </>
  )}

  {paragraphs.length > 0 && (
    <>
      <h2>Biography</h2>
      <div class="bio">{paragraphs.map((part) => <p>{part}</p>)}</div>
    </>
  )}

  {(communities.length > 0 || countries.length > 0) && (
    <>
      <h2>Communities</h2>
      <ul class="tags">{[...communities, ...countries].map((tag) => <li>{tag}</li>)}</ul>
    </>
  )}

  <p class="source">
    {biography?.provenance === 'curated'
      ? 'Biography reviewed and edited by Hall of Fame curators.'
      : 'Biography as recorded by the Cleveland International Hall of Fame.'}
    {person.sourceUrl && <> <a href={person.sourceUrl}>Full profile on the Hall of Fame site</a>.</>}
  </p>
</Layout>
