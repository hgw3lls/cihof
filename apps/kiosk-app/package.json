{
  "name": "@cihof/kiosk-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The installed exhibit as a locked-down desktop app. Not a workspace: its Electron download happens only when packaging.",
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "start": "node scripts/stage.mjs && electron stage",
    "test": "node --test tests/*.test.mjs",
    "test:app": "node tests/app.e2e.mjs",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.cihof.exhibit",
    "productName": "CIHOF Exhibit",
    "copyright": "Western Reserve Historical Society",
    "directories": {
      "app": "stage",
      "output": "../../release/app"
    },
    "files": [
      "**/*",
      "!site/**"
    ],
    "extraResources": [
      {
        "from": "stage/site",
        "to": "site"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CIHOF Exhibit",
      "artifactName": "CIHOF-Exhibit-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "publish": null
  }
}
