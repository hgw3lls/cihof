{
  "name": "@cihof/review-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "src/main.mjs",
  "description": "The CIHOF staff portal: the staff review app in a window of its own. It works on a copy of what a display shows, opened from its export or fetched over its staff connection, and makes display updates; or it reviews the records in a data folder the developer keeps. Not a workspace: its Electron download happens only when packaging.",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.cihof.portal",
    "productName": "CIHOF Staff Portal",
    "copyright": "Western Reserve Historical Society",
    "directories": {
      "output": "../../release/review-app",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CIHOF Staff Portal",
      "artifactName": "CIHOF-Staff-Portal-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "stage/runtime",
        "to": "runtime"
      }
    ]
  }
}
