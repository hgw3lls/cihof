{
  "name": "@cihof/exhibit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The installed exhibit. A long-running, offline-capable touch surface.",
  "dependencies": {
    "@cihof/content": "*",
    "@cihof/pipeline": "*",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "vite": "^8.3.0"
  },
  "scripts": {
    "prebuild": "node --experimental-strip-types scripts/publish.mjs",
    "predev": "npm run prebuild",
    "dev": "vite",
