node_modules/
dist/
.env
.env.local

# OS/editor/build artifacts
.DS_Store
*.bak
*.bak.*
*.tsbuildinfo

# Local safety copies written by scripts/apply-media-decisions.js before it
# edits the manifest. Useful on the machine that made the change, noise in the
# repository — and one reached main before this rule existed.
data/*.backup-*

# Local downloaded video payloads are too large for normal Git storage:
# 633 MP4s, 41 GB. They stay out.
#
# The captions, posters and transcripts sit in the same folder and are 11 MB,
# and they are required — a film is not published without approved captions and
# a transcript, whichever player serves the picture. The 279 files the media
# manifest references are tracked by an explicit `git add -f`, which this
# pattern cannot undo. A NEW film's assets will not be picked up automatically:
# add them the same way. `npm run media:assert` fails when one is missing.
public/media/videos/*
!public/media/videos/.gitkeep

# Local Playwright artifacts
test-results/
playwright-report/

# Build output the apps generate from the sources above
apps/web/public/media/
# Astro regenerates these on every check, build and preview.
apps/web/.astro/
apps/exhibit/public/data/
# Film assets the kiosk build stages from public/media/videos; the originals are
# the tracked (or deliberately untracked) ones.
apps/exhibit/public/media/videos/

# Local reports written by the data scripts
/reports/

# Kiosk packages from npm run package:kiosk. They carry kiosk-only films and
# are handed to the display, never committed or published.
/release/

# The kiosk app's staged copy (npm run stage in apps/kiosk-app): generated, and
# it holds a kiosk build with kiosk-only films.
apps/kiosk-app/stage/
